{
  "manifest_version": 3,
  "name": "DiscordBabel",
  "version": "0.0.2",
  "description": "Translate Discord messages in real time. Free Google/Edge, or your DeepL/AI keys.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://edge.microsoft.com/*",
    "https://translate.volcengine.com/*",
    "https://tokendance.space/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["languages.js", "i18n-messages.js", "i18n.js", "hotkeys.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
